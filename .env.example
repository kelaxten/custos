# Custos Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains passwords.
# Run scripts/setup.sh to auto-generate MQTT credentials.

# ─── Camera credentials ───────────────────────────────────────────────────────
# Password for all Reolink cameras. Set via the setup wizard (custos.local/setup).
FRIGATE_RTSP_PASSWORD=your_camera_password_here

# ─── MQTT credentials ─────────────────────────────────────────────────────────
# Generated automatically by scripts/setup.sh. Used by Mosquitto, Frigate, and HA.
MQTT_USER=custos
MQTT_PASSWORD=change_me
FRIGATE_MQTT_USER=custos
FRIGATE_MQTT_PASSWORD=change_me

# ─── Storage ──────────────────────────────────────────────────────────────────
# Where recordings, snapshots, and logs are stored on the Pi's filesystem.
# Default: /opt/custos/storage — requires ~100GB free for 7-day retention on 2 cameras.
# To use an external drive: CUSTOS_STORAGE_PATH=/mnt/usb-drive/custos
CUSTOS_STORAGE_PATH=/opt/custos/storage

# ─── Custos Energy (optional Time-of-Use module) ──────────────────────────────
# Only used by the custos-energy service. Tariffs are wall-clock, so this MUST
# match your billing locale — leaving it as UTC will switch periods at the wrong
# hour. See custos-energy/README.md.
CUSTOS_ENERGY_TZ=America/Los_Angeles
# Rates ($/kWh) and the fixed daily service charge. Override if your utility
# changes them — no code edit required.
CUSTOS_RATE_OFF_PEAK=0.0882
CUSTOS_RATE_MID_PEAK=0.1543
CUSTOS_RATE_PEAK=0.1763
CUSTOS_BASE_CHARGE_PER_DAY=0.4262
# Set "true" only if your utility bills federally-observed weekdays for holidays
# that land on a weekend (confirm the policy first).
CUSTOS_OBSERVED_HOLIDAYS=false
